config SOFLE_COLOR_G2_PROBE
    bool "Sofle Color G2 hardware interface compile probe"
    default y if SHIELD_SOFLE_COLOR_LEFT || SHIELD_SOFLE_COLOR_RIGHT
    select SPI
    select PWM
    help
      Validate the dedicated SPI2 descriptor and independent active-low
      open-drain gate definitions and PWM0 output resource. Keep LCD/RGB off;
      do not transmit pixels or LED data.
